# ──────────────────────────────────────────────────────
# .env.example — MeetLens v2 Environment Configuration
# ──────────────────────────────────────────────────────
# Copy this file to backend/.env and fill in real values.
# NEVER commit the actual .env file to version control.
# ──────────────────────────────────────────────────────

# Groq API key for Whisper transcription (REQUIRED)
# Get yours at: https://console.groq.com
GROQ_API_KEY = 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

# Groq Whisper model: whisper-large-v3-turbo | whisper-large-v3
GROQ_MODEL=whisper-large-v3-turbo

# Google Gemini API key for summarization (REQUIRED)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY = AIzaSyABnKVkxxmVaOYdApWFJGKROK6HbLxTkN8

# Gemini model: gemini-2.0-flash | gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash

# Audio sample rate (Hz) — should match frontend VAD output
AUDIO_SAMPLE_RATE=16000

# Default output language (ISO 639-1 code)
DEFAULT_LANGUAGE=en

# FastAPI server bind address
BACKEND_HOST=localhost

# FastAPI server port
BACKEND_PORT=8000

# Python logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
