# ──────────────────────────────────────────────────────
# .env.example — MeetLens v3 Environment Configuration
# ──────────────────────────────────────────────────────
# Copy this file to backend/.env and fill in real values.
# NEVER commit the actual .env file to version control.
# ──────────────────────────────────────────────────────

# Groq API key for Whisper transcription + LLM refinement (REQUIRED)
# Get yours at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Whisper model — use whisper-large-v3 for maximum accuracy
# Options: whisper-large-v3 | whisper-large-v3-turbo
GROQ_MODEL=whisper-large-v3

# Groq LLM model for the refinement chain (error correction + translation)
# This model corrects phonetic errors and translates to the target language
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# Google Gemini API key for summarization (REQUIRED)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model: gemini-2.0-flash | gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash

# Audio sample rate (Hz) — must match frontend stream output
AUDIO_SAMPLE_RATE=16000

# Default source language hint for Whisper (ISO 639-1 code)
DEFAULT_LANGUAGE=en

# Target language for LLM translation (ISO 639-1 code)
# If same as DEFAULT_LANGUAGE, LLM only does error correction (no translation)
TARGET_LANGUAGE=en

# ── Silero VAD Tuning ──────────────────────────────
# Speech probability threshold (0.0–1.0). Lower = more sensitive to quiet speech.
# Recommended: 0.35 for meetings (captures soft speakers better)
VAD_THRESHOLD=0.35

# Minimum silence duration (ms) to trigger a sentence boundary
# Recommended: 500ms for faster response in meetings
VAD_MIN_SILENCE_MS=500

# Minimum speech duration (ms) before a segment is emitted
# Recommended: 150ms to catch quick phrases
VAD_MIN_SPEECH_MS=150

# Maximum speech duration (seconds) before force-emitting
VAD_MAX_SPEECH_S=30.0

# ── Server ─────────────────────────────────────────
# FastAPI server bind address
BACKEND_HOST=localhost

# FastAPI server port
BACKEND_PORT=8000

# Python logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
