{
  "manifest_version": 3,
  "name": "MeetLens — Real-Time Meeting Transcriber",
  "version": "2.0.0",
  "description": "Real-time meeting transcription via Groq Whisper with Gemini-powered summaries. Bookmark, export, and edit your transcripts.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MeetLens Transcriber",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "bookmark-section": {
      "suggested_key": {
        "default": "Ctrl+Space",
        "mac": "Command+Space"
      },
      "description": "Bookmark the current transcript position"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
