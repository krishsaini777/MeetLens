{
  "manifest_version": 3,
  "name": "MeetLens — Real-Time Meeting Transcriber",
  "version": "4.0.0",
  "description": "Real-time meeting transcription with speaker diarization, Silero VAD, Groq Whisper + LLM refinement, and Gemini-powered summaries.",
  "permissions": [
    "activeTab",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "http://localhost/*",
    "ws://localhost/*",
    "*://meet.google.com/*",
    "*://teams.microsoft.com/*",
    "*://*.zoom.us/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://meet.google.com/*",
        "*://teams.microsoft.com/*",
        "*://*.zoom.us/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "MeetLens Transcriber",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "commands": {
    "bookmark-section": {
      "suggested_key": {
        "default": "Ctrl+Space",
        "mac": "Command+Space"
      },
      "description": "Bookmark the current transcript position"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
