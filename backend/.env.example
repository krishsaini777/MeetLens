# backend/.env.example — commit this file, it is safe
# Copy to .env and fill in real values.

# Groq API key for Whisper transcription (REQUIRED)
GROQ_API_KEY=your_groq_api_key_here

# Groq Whisper model: whisper-large-v3-turbo | whisper-large-v3
GROQ_MODEL=whisper-large-v3-turbo

# Google Gemini API key for summarization (REQUIRED)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model: gemini-2.0-flash | gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash

# Audio sample rate (Hz) — must match frontend AudioContext (16000 for Whisper)
AUDIO_SAMPLE_RATE=16000

# Default output language (ISO 639-1 code)
DEFAULT_LANGUAGE=en

# Dynamic vocabulary injection for Whisper transcription accuracy.
# Add domain-specific terms, proper nouns, brand names, or acronyms that
# Whisper frequently misrecognizes. Comma-separated, case-sensitive.
# Whisper uses this as contextual hint to prefer these exact spellings.
# Max ~224 tokens (~900 chars). Leave blank to use default behavior.
# Example: WHISPER_CUSTOM_VOCABULARY=MyCompany, ProjectAlpha, Dr. Smith
WHISPER_CUSTOM_VOCABULARY=

# FastAPI server bind address
BACKEND_HOST=localhost

# FastAPI server port
BACKEND_PORT=8000

# Python logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO